# --- Database ---
# Local: SQLite (default). Production on Vercel: Neon or Vercel Postgres.
DATABASE_URL="file:./dev.db"
# Required when DATABASE_URL is Postgres. Use the *unpooled* / direct Neon URL.
# Local SQLite: copy DATABASE_URL or omit (scripts set DIRECT_URL automatically).
DIRECT_URL="file:./dev.db"

# --- NextAuth (required) ---
# openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Local. On Vercel set this to https://YOUR_PROJECT.vercel.app
# If omitted on Vercel, the app falls back to https://$VERCEL_URL
NEXTAUTH_URL="http://localhost:3000"

# --- First-deploy seed (production) ---
# Long random string. POST /api/admin/seed with header x-seed-secret.
# If unset, the seed route returns 404.
SEED_SECRET=
# Set true on the first Vercel deploy so an empty database is seeded.
# Leaves existing demo data alone unless SEED_RESET=true.
SEED_ON_BUILD="false"
SEED_RESET="false"

# --- Optional AI ---
# When unset, a deterministic mock layer still produces Arabic/English insights.
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
