# SQLite for local/demo. Swap to Postgres by changing the Prisma
# datasource provider to "postgresql" and pointing this URL at your DB.
DATABASE_URL="file:./dev.db"

# NextAuth — required. Use a long random string in production.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional. When unset, a deterministic mock AI layer produces
# realistic Arabic/English briefings and simulations from live metrics.
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
